{
  "name": "cutshon",
  "version": "1.0.0",
  "description": "Professional Dead Air Cutter + EDL Exporter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "tauri": "tauri",
    "build:server": "node scripts/prepare-binaries.js && npx pkg server.js --target node18-win-x64 --output src-tauri/bin/server-x86_64-pc-windows-msvc.exe",
    "build:exe": "npm run build:server && npm run tauri build"
  },
  "pkg": {
    "assets": [
      "./public/**/*",
      "./public/**/.*",
      "./lib/**/*"
    ],
    "scripts": [
      "./lib/**/*.js"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jest": "^30.3.0",
    "nodemon": "^2.0.22",
    "pkg": "^5.8.1",
    "supertest": "^7.2.2"
  }
}
